# ---------------------------------------------------------------------------
# ComplianceScout - environment variable template.
# Copy to .env and fill in for local development:
#   cp .env.example .env
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- AWS / Bedrock ---------------------------------------------------------
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Claude Sonnet on Amazon Bedrock (region-appropriate inference profile ID)
BEDROCK_MODEL_ID=
# --- Application -------------------------------------------------------
LOG_LEVEL=INFO

# --- Amazon Bedrock AgentCore -----------------------------------------
# Populate AGENTCORE_MEMORY_ID after running:
#   ./scripts/setup_agentcore.sh memory-create
AGENTCORE_MEMORY_ID=compliance-scout-memory

# Optional: OpenTelemetry exporter overrides (defaults route to AgentCore
# Observability / CloudWatch GenAI Observability when deployed via
# `agentcore deploy`; only set these for a custom OTEL collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=contractor-compliance-scout
